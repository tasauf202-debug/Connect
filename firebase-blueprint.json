{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Private user account record including PII email and admin-controlled ban status.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email address (PII)" },
        "displayName": { "type": "string", "description": "Display name" },
        "photoUrl": { "type": "string", "description": "Optional profile photo URL" },
        "isBanned": { "type": "boolean", "description": "Moderation ban flag controlled exclusively by admins" },
        "isVerified": { "type": "boolean", "description": "Meta-style blue tick verification badge controlled exclusively by admins" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp" }
      },
      "required": ["uid", "email", "displayName", "isBanned", "createdAt", "updatedAt"]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Public non-PII profile directory entry for feed attribution and chat discovery.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoUrl": { "type": "string" },
        "bio": { "type": "string" },
        "isDiscoverable": { "type": "boolean" },
        "profileVisibility": { "type": "string", "enum": ["public", "friends", "private"] },
        "isAdminBadge": { "type": "boolean" },
        "isVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "isDiscoverable", "isAdminBadge", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authoritative admin role grant document.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "grantedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "grantedBy", "createdAt"]
    },
    "FeedPost": {
      "title": "FeedPost",
      "description": "Social media news feed post.",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhotoUrl": { "type": "string" },
        "authorVerified": { "type": "boolean" },
        "content": { "type": "string" },
        "category": { "type": "string", "enum": ["status", "photo", "announcement"] },
        "visibility": { "type": "string", "enum": ["public", "hidden"] },
        "likesCount": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "authorName", "content", "category", "visibility", "likesCount", "commentsCount", "createdAt", "updatedAt"]
    },
    "PostLike": {
      "title": "PostLike",
      "description": "Per-user like marker on a post.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "createdAt"]
    },
    "PostComment": {
      "title": "PostComment",
      "description": "Comment on a feed post.",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "authorId", "authorName", "text", "createdAt"]
    },
    "ChatRoom": {
      "title": "ChatRoom",
      "description": "Private or group chat thread metadata.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "chatType": { "type": "string", "enum": ["private", "group"] },
        "participantIds": { "type": "array" },
        "participantNames": { "type": "object" },
        "createdBy": { "type": "string" },
        "lastMessageText": { "type": "string" },
        "lastSenderId": { "type": "string" },
        "lastSenderName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "chatType", "participantIds", "participantNames", "createdBy", "lastMessageText", "lastSenderId", "lastSenderName", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual message inside a chat room.",
      "type": "object",
      "properties": {
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "participantIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["chatId", "senderId", "senderName", "text", "participantIds", "createdAt"]
    },
    "BroadcastNotice": {
      "title": "BroadcastNotice",
      "description": "Admin broadcast notification displayed across the app.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "priority": { "type": "string", "enum": ["info", "important", "urgent"] },
        "isActive": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "message", "priority", "isActive", "createdBy", "createdAt", "updatedAt"]
    },
    "ModerationSettings": {
      "title": "ModerationSettings",
      "description": "Global application moderation controls managed by admins.",
      "type": "object",
      "properties": {
        "allowNewPosts": { "type": "boolean" },
        "allowNewChats": { "type": "boolean" },
        "autoFilterEnabled": { "type": "boolean" },
        "maintenanceNotice": { "type": "string" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["allowNewPosts", "allowNewChats", "autoFilterEnabled", "maintenanceNotice", "updatedBy", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Private user account documents containing PII."
    },
    "/public_profiles/{userId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Public non-PII user directory."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Authoritative admin role registry."
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/FeedPost" },
      "description": "Social media news feed posts."
    },
    "/posts/{postId}/likes/{userId}": {
      "schema": { "$ref": "#/entities/PostLike" },
      "description": "Per-user post likes."
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/PostComment" },
      "description": "Comments on a feed post."
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatRoom" },
      "description": "Private and group chat conversations."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages inside a chat room."
    },
    "/broadcasts/{broadcastId}": {
      "schema": { "$ref": "#/entities/BroadcastNotice" },
      "description": "Admin broadcast announcements."
    },
    "/app_settings/{settingId}": {
      "schema": { "$ref": "#/entities/ModerationSettings" },
      "description": "Global moderation settings document (moderation)."
    }
  }
}
